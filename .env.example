# Production Environment Configuration
FLASK_ENV=production
SECRET_KEY=your-secure-random-secret-key-change-in-production
PORT=5000

# MongoDB Atlas Production Database URI
# Example format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=hospital_queue

# Optional ML Model Path Overrides (Defaults to local files)
# MODEL_PATH=model.joblib
# FEATURE_ENCODER_PATH=feature_encoder.joblib
# SPECIALTY_ENCODER_PATH=specialty_encoder.joblib
